# Read by /release-ext. Schema documented in ~/.claude/commands/release-ext.md.

extension: lchash
version_macro: PHP_LCHASH_VERSION
version_file: php_lchash.h
repo: iliaal/lchash

# Local rebuild matrix /release-ext runs before tagging. Each entry maps to a
# $HOME/php-install-PHP-<entry> install; missing roots are skipped with a
# warning. CI covers 7.4..8.5 in .github/workflows/tests.yml.
build_matrix:
  - PHP-7.4
  - PHP-8.3
  - PHP-8.4
  - PHP-8.5

configure_base: "--enable-lchash"

# Catches threading regressions before release. Builds against
# ~/php-install-PHP-8.4-zts using the same configure_base.
extra_build_variants:
  - name: "PHP 8.4 ZTS"
    configure: "--enable-lchash"
    php_version: PHP-8.4-zts

# AddressSanitizer + UBSan run as part of /release-ext. The extension manages
# refcounts on every stored key and value, and a leak shipped in 0.9.1.
asan_test: true

# Windows binaries ship via .github/workflows/release-windows.yml on every
# GitHub Release: PHP 8.3/8.4/8.5 x x64/x86 x NTS/TS via php-windows-builder.
windows_ci: true
